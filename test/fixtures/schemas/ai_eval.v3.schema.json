{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI evaluation run of one repository (Complyd AI release, v3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool", "format", "commit", "run_id", "ran_at", "suites", "truncated"],
  "properties": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "x-complyd-privacy": "none",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9 ._/@+-]{1,64}$",
          "x-complyd-privacy": "none"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+-]{1,40}$",
          "x-complyd-privacy": "none"
        }
      }
    },
    "format": {
      "enum": ["promptfoo", "deepeval", "openai-evals", "lm-eval", "generic"],
      "x-complyd-privacy": "none"
    },
    "commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "x-complyd-privacy": "none"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
      "x-complyd-privacy": "none"
    },
    "ran_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "x-complyd-privacy": "none",
      "x-complyd-volatile": true
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "x-complyd-privacy": "none",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "model",
          "prompt_sha256",
          "test_set",
          "evaluator",
          "metrics",
          "cases",
          "passed"
        ],
        "if": {
          "description": "ADR 0022 §5.8: a re-scored baseline serves stored outputs, so it must say it is a replay.",
          "properties": { "rescored": { "const": true } },
          "required": ["rescored"]
        },
        "then": {
          "properties": { "execution": { "const": "replay" } },
          "required": ["execution"]
        },
        "properties": {
          "execution": {
            "enum": ["live", "scripted", "replay"],
            "x-complyd-privacy": "none"
          },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "x-complyd-privacy": "none",
            "properties": {
              "calls": { "$ref": "#/$defs/tokens", "x-complyd-privacy": "none" },
              "input_tokens": { "$ref": "#/$defs/tokens", "x-complyd-privacy": "none" },
              "output_tokens": { "$ref": "#/$defs/tokens", "x-complyd-privacy": "none" },
              "cached_input_tokens": { "$ref": "#/$defs/tokens", "x-complyd-privacy": "none" },
              "cost_usd": {
                "type": "string",
                "pattern": "^[0-9]{1,8}(\\.[0-9]{1,6})?$",
                "x-complyd-privacy": "none"
              }
            }
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9 ._:/@+-]{1,128}$",
            "x-complyd-privacy": "none"
          },
          "role": {
            "enum": ["baseline", "candidate"],
            "x-complyd-privacy": "none"
          },
          "test_set": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "cases"],
            "x-complyd-privacy": "none",
            "properties": {
              "version": { "$ref": "#/$defs/ref", "x-complyd-privacy": "none" },
              "cases": { "$ref": "#/$defs/count", "x-complyd-privacy": "none" },
              "selection": {
                "enum": ["production_sample", "curated", "synthetic", "regression", "mixed"],
                "x-complyd-privacy": "none"
              },
              "expected_version": { "$ref": "#/$defs/ref", "x-complyd-privacy": "none" }
            }
          },
          "evaluator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "parser"],
            "x-complyd-privacy": "none",
            "properties": {
              "judge_model": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:/@+-]{1,200}$",
                "x-complyd-privacy": "none"
              },
              "rubric_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "x-complyd-privacy": "none"
              },
              "version": { "$ref": "#/$defs/ref", "x-complyd-privacy": "none" },
              "parser": { "$ref": "#/$defs/ref", "x-complyd-privacy": "none" }
            }
          },
          "run_conditions_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "x-complyd-privacy": "none"
          },
          "rescored": {
            "type": "boolean",
            "x-complyd-privacy": "none"
          },
          "anchor_check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cases", "agreed"],
            "x-complyd-privacy": "none",
            "properties": {
              "cases": { "$ref": "#/$defs/count", "x-complyd-privacy": "none" },
              "agreed": { "$ref": "#/$defs/count", "x-complyd-privacy": "none" }
            }
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "id"],
            "x-complyd-privacy": "none",
            "properties": {
              "provider": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                "x-complyd-privacy": "none"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:/@+-]{1,128}$",
                "x-complyd-privacy": "none"
              },
              "version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:/@+-]{1,64}$",
                "x-complyd-privacy": "none"
              }
            }
          },
          "prompt_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:/@+-]{1,64}$",
            "x-complyd-privacy": "none"
          },
          "prompt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "x-complyd-privacy": "none"
          },
          "dataset": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256"],
            "x-complyd-privacy": "none",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:/@+-]{1,200}$",
                "x-complyd-privacy": "none"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "x-complyd-privacy": "none"
              }
            }
          },
          "metrics": {
            "type": "array",
            "maxItems": 50,
            "x-complyd-privacy": "none",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value", "passed"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9 ._:/@+-]{1,64}$",
                  "x-complyd-privacy": "none"
                },
                "category": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9 ._:/@+-]{1,64}$",
                  "x-complyd-privacy": "none"
                },
                "value": { "$ref": "#/$defs/decimal", "x-complyd-privacy": "none" },
                "threshold": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value", "direction"],
                  "x-complyd-privacy": "none",
                  "properties": {
                    "value": { "$ref": "#/$defs/decimal", "x-complyd-privacy": "none" },
                    "direction": {
                      "enum": ["gte", "lte"],
                      "x-complyd-privacy": "none"
                    }
                  }
                },
                "passed": {
                  "type": "boolean",
                  "x-complyd-privacy": "none"
                }
              }
            }
          },
          "cases": {
            "type": "object",
            "additionalProperties": false,
            "required": ["total", "passed", "failed", "errored"],
            "x-complyd-privacy": "none",
            "properties": {
              "total": { "$ref": "#/$defs/count", "x-complyd-privacy": "none" },
              "passed": { "$ref": "#/$defs/count", "x-complyd-privacy": "none" },
              "failed": { "$ref": "#/$defs/count", "x-complyd-privacy": "none" },
              "errored": { "$ref": "#/$defs/count", "x-complyd-privacy": "none" }
            }
          },
          "passed": {
            "type": "boolean",
            "x-complyd-privacy": "none"
          }
        }
      }
    },
    "truncated": {
      "type": "boolean",
      "x-complyd-privacy": "none"
    },
    "repo_config": { "$ref": "#/$defs/repo_config", "x-complyd-privacy": "none" }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0, "maximum": 10000000 },
    "tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
    "ref": { "type": "string", "pattern": "^[A-Za-z0-9._:/@+-]{1,64}$" },
    "decimal": { "type": "string", "pattern": "^-?[0-9]{1,12}(\\.[0-9]{1,9})?$" },
    "repo_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "config_sha256", "systems"],
      "properties": {
        "version": { "type": "integer", "minimum": 1, "maximum": 2, "x-complyd-privacy": "none" },
        "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "x-complyd-privacy": "none" },
        "systems": {
          "type": "array",
          "maxItems": 50,
          "x-complyd-privacy": "none",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["paths", "suites"],
            "properties": {
              "system": { "type": "string", "pattern": "^[A-Za-z0-9 ._:/@+-]{1,128}$", "x-complyd-privacy": "none" },
              "paths": {
                "type": "array",
                "maxItems": 100,
                "x-complyd-privacy": "none",
                "items": { "type": "string", "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$))[A-Za-z0-9 ._@+/*?-]{1,200}$" }
              },
              "suites": {
                "type": "array",
                "maxItems": 50,
                "x-complyd-privacy": "none",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "required", "metrics"],
                  "properties": {
                    "name": { "type": "string", "pattern": "^[A-Za-z0-9 ._:/@+-]{1,128}$", "x-complyd-privacy": "none" },
                    "required": { "type": "boolean", "x-complyd-privacy": "none" },
                    "execution": { "enum": ["live", "scripted", "replay"], "x-complyd-privacy": "none" },
                    "metrics": {
                      "type": "object",
                      "propertyNames": { "type": "string", "pattern": "^[A-Za-z0-9 ._:/@+-]{1,64}$" },
                      "maxProperties": 50,
                      "x-complyd-privacy": "none",
                      "additionalProperties": {
                        "type": "object",
                        "additionalProperties": false,
                        "minProperties": 1,
                        "maxProperties": 1,
                        "x-complyd-privacy": "none",
                        "properties": {
                          "gte": { "type": "string", "pattern": "^-?[0-9]{1,12}(\\.[0-9]{1,9})?$", "x-complyd-privacy": "none" },
                          "lte": { "type": "string", "pattern": "^-?[0-9]{1,12}(\\.[0-9]{1,9})?$", "x-complyd-privacy": "none" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
